{
  "name": "MailCraft:Email-Extension",
  "description": "AI Powered email reply generator",
  "version": "1.0",
  "manifest_version": 3,

  "permissions": [
    "activeTab",
    "scripting",
    "tabs",
    "storage"
  ],

  "host_permissions": [
    "http://localhost:8080/*",
    "*://mail.google.com/*"
  ],

  "action": {
    "default_title": "MailCraft:Email-Extension",
    "default_popup": "mailcraft.html",
    "default_icon": "mailcraft-extensions.png"
  },

  "content_scripts": [
    {
      "js": [
        "content.js"
      ],
      "matches": [
        "*://mail.google.com/*"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_idle"
    }
  ],

  "web_accessible_resources": [
    {
      "resources": [
        "icons/*"
      ],
      "matches": [
        "*://mail.google.com/*"
      ]
    }
  ]
}